{
  "version": 9,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "KICAD_BUILD_QA_TESTS": "OFF",
        "KICAD_BUILD_I18N": "OFF",
        "KICAD_SCRIPTING_WXPYTHON": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_ROOT}/installed",
        "PYTHON_EXECUTABLE": "$env{VCPKG_ROOT}/installed/x64-windows/tools/python3/python.exe"
      }
    },
    {
      "name": "x64-debug",
      "displayName": "x64 Debug",
      "description": "Sets debug build type and x64 arch",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_ROOT}/installed"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    },
    {
      "name": "x64-release",
      "displayName": "x64 Release",
      "description": "Sets release build type",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_ROOT}/installed"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "kicad",
      "configurePreset": "x64-debug",
      "configuration": "Debug",
      "targets": [
        "install"
      ]
    },
    {
      "name": "x64-debug",
      "configurePreset": "x64-debug",
      "configuration": "Debug"
    },
    {
      "name": "x64-release",
      "configurePreset": "x64-release",
      "configuration": "RelWithDebInfo"
    }
  ],
  "workflowPresets": [
    {
      "name": "kicad",
      "description": "kicad",
      "displayName": "kicad",
      "steps": [
        {
          "type": "configure",
          "name": "x64-debug"
        },
        {
          "type": "build",
          "name": "kicad"
        }
      ]
    }
  ]
}