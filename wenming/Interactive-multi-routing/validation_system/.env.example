# Anthropic API Key (required)
ANTHROPIC_API_KEY=your_api_key_here

# Custom API Endpoint (optional)
# If using a third-party Claude API service, set this to the base URL
# Example: ANTHROPIC_API_BASE=https://crsacc.itssx.com/api
# Leave commented out to use official Anthropic API
# ANTHROPIC_API_BASE=

# KiCad Repository Path (optional, defaults to parent directory)
# KICAD_REPO_PATH=/path/to/kicad-source-mirror

# Design Document Path (optional)
# DESIGN_DOC_PATH=./wenming/Interactive-multi-routing/KiCad多线同步布线技术设计文档.md

# Output Directory (optional)
# OUTPUT_DIR=./validation_output
